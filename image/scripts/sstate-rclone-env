#!/usr/bin/env bash
creds=$1
endpoint=$2
if [ -z "${AWS_ACCESS_KEY_ID:-}" ] && [ -f "$creds" ]; then
  # shellcheck disable=SC1090
  source "$creds"
fi
: "${AWS_ACCESS_KEY_ID:?no R2 keys: export AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY}"
: "${AWS_SECRET_ACCESS_KEY:?no R2 secret key}"
export RCLONE_CONFIG_R2_TYPE=s3
export RCLONE_CONFIG_R2_PROVIDER=Cloudflare
export RCLONE_CONFIG_R2_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID
export RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY
export RCLONE_CONFIG_R2_ENDPOINT=$endpoint
export RCLONE_CONFIG_R2_NO_CHECK_BUCKET=true
RCLONE_DOCKER_ENV=(
  -e RCLONE_CONFIG_R2_TYPE -e RCLONE_CONFIG_R2_PROVIDER -e RCLONE_CONFIG_R2_ACCESS_KEY_ID
  -e RCLONE_CONFIG_R2_SECRET_ACCESS_KEY -e RCLONE_CONFIG_R2_ENDPOINT -e RCLONE_CONFIG_R2_NO_CHECK_BUCKET
)
