#!/bin/sh

GPIOX_17=493
BTATTACH_PID=/run/btattach.pid
BTATTACHD="btattach -P bcm -B /dev/ttyS1"

hw_reset_bt() {
    echo "|-----Bluetooth HW reset-----|"
    if  [ ! -f /sys/class/gpio/gpio493/direction  ]; then
        echo ${GPIOX_17} > /sys/class/gpio/export
        echo out > /sys/class/gpio/gpio493/direction
    fi
    # Pull the gpio pin down to reset chip
    echo 0 > /sys/class/gpio/gpio493/value
    sleep 0.1
    # Turn off reset
    echo 1 > /sys/class/gpio/gpio493/value
    # Give the chip some time to start
    sleep 0.3
}


echo "|-----Bluetooth STARTING-----|"

serial="$(cat /sys/class/efuse/usid | tail -c 5)"
bt_mac="$(awk -F: '/0x00/ { split(toupper($2), s, " ") ; printf("%s:%s:%s:%s:%s:%s\n", s[1], s[2], s[3], s[4], s[5], s[6]) }' /sys/class/efuse/mac_bt)"
if [ ${#serial} -eq 4 ] && [ ${#bt_mac} -eq 17 ]; then
    bt_settings_path="/var/lib/bluetooth/${bt_mac}"
    if [ ! -f "${bt_settings_path}/settings" ]; then
        mkdir -p "${bt_settings_path}"
        printf "[General]\nAlias=Nocturne (%s)\n" "${serial}" > "${bt_settings_path}/settings"
    fi
else
    echo "Invalid serial or Bluetooth MAC address, falling back to Bluetooth device name \"Nocturne\": serial: \"${serial}\", BT MAC: \"${bt_mac}\""
fi

if [ ! -f ${BTATTACH_PID} ]; then
    hw_reset_bt
    start-stop-daemon --start --quiet --make-pidfile --pidfile ${BTATTACH_PID} --background --startas \
    /bin/sh -- -c "exec ${BTATTACHD}"
fi
