# <file system> <mount pt>  <type>   <options>                                   <dump>  <pass>
/dev/system_a   /           ext4     ro,noload,noauto,noatime,errors=remount-ro  0 1
/dev/system_b   /           ext4     ro,noload,noauto,noatime,errors=remount-ro  0 1
/dev/data       /var        ext4     rw                                          0 0
/dev/settings   /var/lib    ext4     rw                                          0 0

/var/local/root /root       none     defaults,bind                               0 0
/var/local/home /home       none     defaults,bind                               0 0

/var/swapfile   none        swap     defaults                                    0 0

proc            /proc       proc     defaults                                    0 0
devpts          /dev/pts    devpts   defaults,gid=5,mode=620,ptmxmode=0666       0 0
tmpfs           /dev/shm    tmpfs    mode=0777                                   0 0
tmpfs           /tmp        tmpfs    mode=1777                                   0 0
tmpfs           /run        tmpfs    mode=0755,nosuid,nodev                      0 0
sysfs           /sys        sysfs    defaults                                    0 0
