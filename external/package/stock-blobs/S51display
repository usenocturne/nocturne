#!/bin/sh

[ -d /run/wayland ] || mkdir -p /run/wayland
chmod 0700 /run/wayland

export XDG_RUNTIME_DIR=/run/wayland/

modprobe mali

START_PARAMTERS="--tty=4 --config=/etc/weston/weston.ini --log=/tmp/weston.log"

DAEMON=/usr/bin/weston
PIDFILE=/var/run/weston.pid

case "$1" in
  start)
    echo "Starting weston..."
    # shellcheck disable=SC2086
    start-stop-daemon -S -m -p "$PIDFILE" -b -x "$DAEMON" -- $START_PARAMTERS
    ;;
  stop)
    echo "Stopping weston..."
    killall weston
    start-stop-daemon -K -o -p "$PIDFILE"
    rm -f "$PIDFILE"
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac

exit $?
